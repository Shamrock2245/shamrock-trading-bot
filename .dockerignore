# Secrets & credentials — NEVER copy into image
.env
.env.*
!.env.example
.shamrock_deploy_key
.shamrock_deploy_key.pub
deploy_bot.exp
install_key.exp
deploy_now.sh

# Git
.git/
.gitignore

# Python artifacts
# A pattern with no slash matches only the context root ('*' does not match '/').
venv/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
htmlcov/
.coverage
.tox/
**/node_modules/
**/.web/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime data & logs.
# These live on bind mounts (./data, ./logs, ./output in docker-compose.yml).
# The image only needs the Python packages under data/ (models, providers).
# Do not exclude data/ itself.
#
# Docker uses moby/patternmatcher: '*' does not cross '/'. '*.db' excludes a
# database at the context root and still sends data/optuna_studies.db (208MB
# on the paper server, 241MB context, copied into every image). '**' matches
# across directories, including zero.
logs/
output/
data/candles/
data/dashboard/
data/backtest/
data/*.csv
data/**/*.csv
data/*.json
data/**/*.json
data/**/*.jsonl
data/**/*.parquet
data/**/*.pkl
data/**/*.joblib
*.log
**/*.log
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
**/*.db-wal
**/*.db-shm
**/*.db-journal
**/*.sqlite-wal
**/*.sqlite-shm

# Agent & workflow configs
.agent/
.agents/
.gemini/

# Documentation (not needed in container)
docs/
reports/
*.md
!requirements.txt

# Scripts not needed in container. The directory is excluded, then each
# compose `python3 scripts/...` entrypoint is re-included. A new service
# command must be added here or the container crash-loops with Errno 2.
scripts/
!scripts/__init__.py
!scripts/health_check.py
!scripts/paper_trade.py
!scripts/grade_wallets.py
!scripts/benchmark_loop.py
!scripts/reviewer.py
!scripts/monitor_check.py
!scripts/auto_tuner_service.py
!scripts/walk_forward_tuner.py
tests/
