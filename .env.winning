# ═══════════════════════════════════════════════════════════════════════════════
# SHAMROCK: v32 "Let Winners Breathe" (trade_history 34) — copy keys into live .env
# Wired in main.py trailing monitor + hl_perps_scanner + daily_goal_engine
# ═══════════════════════════════════════════════════════════════════════════════

# ── Winning Risk Manager (exit side) ──────────────────────────────────────────
WINNING_RISK_MANAGER_ENABLED=true

# Ultra-Fast Break-even: lock SL at +0.75%
FAST_BREAK_EVEN_PCT=0.75
FAST_BREAK_EVEN_SL_OFFSET=0.05

# TP1 Front-loading: close 40% at +2% (v32: was 50% — keep more runner)
TP1_PROFIT_PCT=2.0
TP1_SIZE_PCT=40

# 45-Min Rule (v32): if still red after 45m, tighten SL to −1.5%
MIN_RULE_TIME_MINUTES=45
MIN_RULE_SL_OFFSET=-1.5

# Tiered trail from peak (v32): base 1.25%, widens with profit
TRAILING_STOP_PCT=1.25
TRAIL_LADDER=2:1.25,4:1.75,8:2.5

# Hard loss timeout (v32: 4h — 1–4h holds are the profitable bucket; 1.5h choked them)
WINNING_LOSS_TIMEOUT_HOURS=4.0

# Toxic zone: cut size 50% during 08:00–14:00 America/New_York
TOXIC_ZONE_RESTRICTION=true
TOXIC_ZONE_START=8
TOXIC_ZONE_END=14
TOXIC_ZONE_SIZE_MULT=0.5

# ── Winning Entry Filter ──────────────────────────────────────────────────────
WINNING_ENTRY_FILTER_ENABLED=true
MIN_VOLUME_USD=1000000
USE_VWAP_FILTER=true
NARRATIVE_SCORE_THRESHOLD=0.8
NARRATIVE_GATE_BYPASS=true
MAX_ATR_PCT=5.0
HIGH_VOL_SIZE_MULTIPLIER=0.5

# ── Churn caps (v32) ──────────────────────────────────────────────────────────
HL_PERPS_MAX_NEW_PER_SCAN=2
HL_PERPS_MAX_OPENS_PER_DAY=24
HL_PERPS_EDGE_SIZING_ENABLED=true
HL_PERPS_EDGE_SIZE_MIN=0.6
HL_PERPS_EDGE_SIZE_MAX=1.3
HL_PERPS_EDGE_MIN_TRADES=4

# ── Keep profit-lock as fallback when Winning is disabled ─────────────────────
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_BE_PCT=1.5
PROFIT_LOCK_TRAIL_ACTIVATE_PCT=3.0
PROFIT_LOCK_TRAIL_DISTANCE_PCT=1.5
PROFIT_LOCK_LOSS_TIMEOUT_HOURS=4.0

# ── Toxic / hard-ban ──────────────────────────────────────────────────────────
HL_PERPS_TOXIC_COINS=AAVE
HL_PERPS_HARD_BAN_COINS=KAITO,APE,HEMI,ONDO,GRASS,TRB,HMSTR,FARTCOIN,MET,EIGEN,MORPHO,LIT,HYPE,BRETT,POPCAT,MEME,JTO

# HF Moralis scanner is still a stub — DO NOT enable
HF_MORALIS_SCANNER_ENABLED=false
