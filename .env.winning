# ═══════════════════════════════════════════════════════════════════════════════
# SHAMROCK TRADING BOT: "WINNING" TUNING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# These settings implement aggressive profit capture and loss prevention.
# Deploy after confirming the bot is running with the latest code.

# ─────────────────────────────────────────────────────────────────────────────
# WINNING RISK MANAGER SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
WINNING_RISK_MANAGER_ENABLED=true

# Ultra-Fast Break-even: Lock break-even at +0.75% (vs. +1.5%)
FAST_BREAK_EVEN_PCT=0.75
FAST_BREAK_EVEN_SL_OFFSET=0.05  # Entry + 0.05%

# TP1 Front-loading: Close 50% at +2% profit
TP1_PROFIT_PCT=2.0
TP1_SIZE_PCT=50

# The 30-Min Rule: Tighten SL to -1% if no profit in 30 minutes
MIN_RULE_TIME_MINUTES=30
MIN_RULE_SL_OFFSET=-1.0

# Aggressive Trailing Stop: 0.5% trailing (vs. 1.5%)
TRAILING_STOP_PCT=0.5

# Toxic Zone Restriction: Reduce size 50% during 08:00-14:00 EST
TOXIC_ZONE_RESTRICTION=true
TOXIC_ZONE_START=8
TOXIC_ZONE_END=14

# ─────────────────────────────────────────────────────────────────────────────
# WINNING ENTRY FILTER SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
WINNING_ENTRY_FILTER_ENABLED=true

# Volume Floor: Minimum $1M 24h volume (was $100k)
MIN_VOLUME_USD=1000000

# VWAP Filter: Only enter if price is above VWAP on 15m
USE_VWAP_FILTER=true
VWAP_TIMEFRAME=15m

# Narrative Bonus: Coins with Narrative Score > 0.8 can bypass strict gate
NARRATIVE_SCORE_THRESHOLD=0.8
NARRATIVE_GATE_BYPASS=true

# Volatility Adjustment: High ATR (>5%) reduces position size by 50%
MAX_ATR_PCT=5.0
HIGH_VOL_SIZE_MULTIPLIER=0.5

# ─────────────────────────────────────────────────────────────────────────────
# PROFIT-LOCK MANAGER SETTINGS (from previous upgrade)
# ─────────────────────────────────────────────────────────────────────────────
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_STATE_FILE=/app/data/hl_trailing_state.json

# ─────────────────────────────────────────────────────────────────────────────
# MORALIS SCANNER SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
HF_MORALIS_SCANNER_ENABLED=true
HF_SCANNER_INTERVAL=300  # 5 minutes

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTES
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy these settings to your main .env file
# 2. Run: docker compose build --no-cache
# 3. Run: docker compose up -d
# 4. Monitor logs: docker compose logs -f shamrock-bot
# 5. Expected improvement: Profit Factor from 0.68 → 1.5+ within 3-7 days
